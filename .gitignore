@'
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Operating system
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Local database and temporary files
*.sqlite
*.db
'@ | Set-Content -Encoding utf8 .gitignore